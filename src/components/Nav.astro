---
/*
  Site chrome per DESIGN-SPEC.md v2: DS nav pattern + locked IA.
  Anton wordmark left, bracketed mono links right. Sticky, hairline bottom.
  Hover/active: ink → signal red.

  Projects and Commercial each get a dropdown listing their actual pages
  (project titles / commercial categories), pulled live from the content
  collections so it never goes stale as sections are added. The nav label
  itself still links straight to the section index — the small [+] toggle
  is a separate control for the list, not a replacement for the link.
*/
import { getCollection } from 'astro:content';
import { SHOW_DRAFTS } from '../lib/flags';

const { pathname } = Astro.url;
const isActive = (path: string) =>
  pathname === path || pathname.startsWith(path + '/');

const projects = (await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const commercial = (
  await getCollection('commercial', ({ data }) => SHOW_DRAFTS || !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const links = [
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---

<header class="site-nav page-pad">
  <a href="/" class="wordmark" aria-label="James Kendall home">James Kendall</a>
  <nav aria-label="Primary">
    <ul class="nav-list">
      <li class="nav-item" data-nav-dropdown>
        <a
          href="/projects"
          class:list={[{ active: isActive('/projects') }]}
          aria-current={isActive('/projects') ? 'page' : undefined}
        >[Projects]</a>
        <button
          type="button"
          class="dropdown-toggle"
          aria-expanded="false"
          aria-controls="dropdown-projects"
          aria-label="Show list of projects"
        >▾</button>
        <ul id="dropdown-projects" class="dropdown-panel" hidden>
          {projects.map((p) => (
            <li>
              <a href={`/projects/${p.id}`}>
                {p.data.title}
                <span class="dropdown-meta">
                  {p.data.years}{p.data.draft ? ' · DRAFT' : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </li>
      <li class="nav-item" data-nav-dropdown>
        <a
          href="/commercial"
          class:list={[{ active: isActive('/commercial') }]}
          aria-current={isActive('/commercial') ? 'page' : undefined}
        >[Commercial]</a>
        <button
          type="button"
          class="dropdown-toggle"
          aria-expanded="false"
          aria-controls="dropdown-commercial"
          aria-label="Show list of commercial categories"
        >▾</button>
        <ul id="dropdown-commercial" class="dropdown-panel" hidden>
          {commercial.map((c) => (
            <li>
              <a href={`/commercial/${c.id}`}>
                {c.data.title}
                {c.data.draft && <span class="dropdown-meta">DRAFT</span>}
              </a>
            </li>
          ))}
        </ul>
      </li>
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[{ active: isActive(href) }]}
            aria-current={isActive(href) ? 'page' : undefined}
          >[{label}]</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));

  function closeAll(except?: HTMLElement) {
    items.forEach((item) => {
      if (item === except) return;
      const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
      const panel = item.querySelector<HTMLElement>('.dropdown-panel');
      toggle?.setAttribute('aria-expanded', 'false');
      if (toggle) toggle.textContent = '▾';
      if (panel) panel.hidden = true;
    });
  }

  function open(item: HTMLElement) {
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
    const panel = item.querySelector<HTMLElement>('.dropdown-panel');
    closeAll(item);
    toggle?.setAttribute('aria-expanded', 'true');
    if (toggle) toggle.textContent = '▴';
    if (panel) panel.hidden = false;
  }

  function close(item: HTMLElement) {
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');
    const panel = item.querySelector<HTMLElement>('.dropdown-panel');
    toggle?.setAttribute('aria-expanded', 'false');
    if (toggle) toggle.textContent = '▾';
    if (panel) panel.hidden = true;
  }

  function isOpen(item: HTMLElement) {
    return item.querySelector('.dropdown-toggle')?.getAttribute('aria-expanded') === 'true';
  }

  // Click-only, deliberately no hover-to-open. Hovering across the nav to
  // reach Writing/About was popping a heavy panel open uninvited, and
  // fast mouse movement between the two toggles could leave both open at
  // once. A click is a clear, single, unambiguous "open this" action.
  items.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.dropdown-toggle');

    toggle?.addEventListener('click', () => {
      isOpen(item) ? close(item) : open(item);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const insideAny = items.some((item) => item.contains(target));
    if (!insideAny) closeAll();
  });
</script>

<style>
  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
    position: sticky;
    top: 0;
    background: var(--paper-1);
    z-index: 10;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    text-transform: uppercase;
    color: var(--ink-1);
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .wordmark:hover {
    color: var(--signal-red);
  }

  /* .nav-list, not "nav ul" — the dropdown panels below are also <ul>
     elements nested inside <nav>, and a plain descendant selector would
     have flexed them into a row too (this is exactly what broke the
     dropdown layout the first time round). */
  .nav-list {
    display: flex;
    gap: 28px;
    align-items: center;
    list-style: none;
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-1);
  }

  nav a:hover,
  nav a.active {
    color: var(--signal-red);
  }

  .dropdown-toggle {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    background: none;
    border: var(--border-width-hairline) solid var(--border-hairline);
    color: var(--ink-1);
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
  }

  .dropdown-toggle:hover,
  .dropdown-toggle[aria-expanded='true'] {
    color: var(--signal-red);
    border-color: var(--signal-red);
  }

  /* Paper-toned, not the dark .inverse surface — that token is meant for
     full-bleed poster moments, not a small nav utility panel, and used
     here it read as loud and heavy rather than a quiet list of links.
     A flat hard-offset shadow (--shadow-paper, no blur, DS-approved) gives
     it just enough lift to read as a floating panel over the page. */
  /* :not([hidden]) — the same trap the carousel hit earlier in this build:
     author CSS setting "display" always beats the browser's own
     "[hidden] { display: none }", regardless of specificity. An
     unconditional "display: block" here is what made the JS's hidden
     toggle stop having any visible effect — panels looked "stuck open"
     because the attribute was changing correctly, the CSS just no longer
     cared about it. */
  .dropdown-panel:not([hidden]) {
    display: block;
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    z-index: 20;
    min-width: 220px;
    max-width: 300px;
    list-style: none;
    padding: var(--space-4);
    background: var(--paper-2);
    border: var(--border-width-hairline) solid var(--border-hairline);
    box-shadow: var(--shadow-paper);
  }

  .dropdown-panel li + li {
    margin-top: var(--space-3);
  }

  /* Explicit colour here, not inherited from "nav a" — that rule is scoped
     to this component too, and because Astro's scoping attribute stacks
     onto every selector segment, "nav a" ended up more specific than the
     old dark-panel text colour and silently won, rendering every title
     in dark ink on a dark background. Setting it directly here removes
     any ambiguity about which rule wins. */
  .dropdown-panel a {
    display: block;
    font-size: 13px;
    letter-spacing: normal;
    text-transform: none;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .dropdown-panel a:hover {
    color: var(--signal-red);
  }

  .dropdown-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-top: 2px;
  }

  @media (max-width: 720px) {
    .site-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .nav-list { flex-wrap: wrap; gap: var(--space-4); }
    .nav-item {
      flex-wrap: wrap;
      width: 100%;
    }
    /* :not([hidden]) here too — not for the display trap this time, but for
       specificity: the base rule above is .dropdown-panel:not([hidden])
       (0,2,0 before scoping), so a bare .dropdown-panel (0,1,0) in this
       media query silently loses every property the base rule also sets.
       That left position: absolute and max-width: 300px winning on narrow
       screens, so the panel floated over the page instead of collapsing
       to an inline block as intended. Selectors must match in specificity
       for the override to take. */
    .dropdown-panel:not([hidden]) {
      position: static;
      margin-top: var(--space-2);
      width: 100%;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel { transition: none; }
  }
</style>
