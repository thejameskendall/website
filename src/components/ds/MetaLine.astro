---
/* Catalogue metadata row: hairline borders, evenly distributed mono cells. Ported from DS core. */
interface Props {
  items: string[];
  border?: 'top' | 'bottom' | 'both' | 'none';
  class?: string;
}
const { items, border = 'top', class: className } = Astro.props;
---

<div
  class:list={[
    'metaline',
    className,
    { 'b-top': border === 'top' || border === 'both' },
    { 'b-bottom': border === 'bottom' || border === 'both' },
  ]}
>
  {items.map((it) => <span>{it}</span>)}
</div>

<style>
  .metaline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 7px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-1);
  }
  .b-top { border-top: var(--border-width-hairline) solid var(--border-hairline); }
  .b-bottom { border-bottom: var(--border-width-hairline) solid var(--border-hairline); }
  span { white-space: nowrap; }

  @media (max-width: 720px) {
    .metaline { flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  }
</style>
