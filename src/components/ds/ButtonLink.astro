---
/*
  Poster-print button as a link: square corners, 2px ink border,
  full invert on hover, deeper red press. Ported from DS core Button.
  Rendered as <a> — the site has no forms (mailto contact only).
*/
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
}
const { href, variant = 'primary', size = 'md' } = Astro.props;
---

<a class:list={['btn', variant, size]} href={href}><slot /></a>

<style>
  .btn {
    display: inline-block;
    font-family: var(--font-grotesque);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: var(--radius-0);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .sm { padding: 8px 16px; font-size: 12px; }
  .md { padding: 12px 24px; font-size: 15px; }
  .lg { padding: 16px 32px; font-size: 17px; }

  .primary {
    background: var(--ink-1);
    color: var(--paper-1);
    border: var(--border-width-strong) solid var(--ink-1);
  }
  .primary:hover {
    background: var(--signal-red);
    border-color: var(--signal-red);
    color: var(--paper-1);
  }
  .primary:active {
    background: var(--signal-red-deep);
    border-color: var(--signal-red-deep);
  }

  .secondary {
    background: transparent;
    color: var(--ink-1);
    border: var(--border-width-strong) solid var(--ink-1);
  }
  .secondary:hover {
    background: var(--ink-1);
    color: var(--paper-1);
  }

  .ghost {
    background: transparent;
    color: var(--ink-1);
    border: var(--border-width-strong) solid transparent;
  }
  .ghost:hover {
    color: var(--signal-red);
  }
</style>
