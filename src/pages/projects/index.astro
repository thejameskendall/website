---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetaLine from '../../components/ds/MetaLine.astro';
import PosterCard from '../../components/ds/PosterCard.astro';
import { getCollection } from 'astro:content';
import { SHOW_DRAFTS } from '../../lib/flags';
import { placeholderImage } from '../../lib/placeholders';

const projects = (await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const count = `[${String(projects.length).padStart(2, '0')}]`;
---

<BaseLayout title="Projects" description="Contemporary art photography projects by James Kendall.">
  <section class="title-block page-pad">
    <h1>Projects</h1>
  </section>

  <div class="page-pad">
    <MetaLine border="both" items={['ART PRACTICE', count, 'PHOTOGRAPHY + TEXT']} />
  </div>

  <section class="grid page-pad">
    {projects.map((p) => (
      <PosterCard
        href={`/projects/${p.id}`}
        title={p.data.title}
        image={p.data.images?.[0]?.src.src ?? p.data.coverImage ?? placeholderImage(p.id)}
        meta={[p.data.years, ...(p.data.draft ? ['DRAFT'] : [])]}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .title-block {
    padding-top: 36px;
    padding-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-top: var(--space-5);
    padding-bottom: 56px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
