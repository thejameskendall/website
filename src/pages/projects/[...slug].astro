---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ds/Tag.astro';
import Sticker from '../../components/ds/Sticker.astro';
import MetaLine from '../../components/ds/MetaLine.astro';
import ButtonLink from '../../components/ds/ButtonLink.astro';
import RelatedStrip from '../../components/RelatedStrip.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { SHOW_DRAFTS } from '../../lib/flags';
import { placeholderImage } from '../../lib/placeholders';

export async function getStaticPaths() {
  const { SHOW_DRAFTS } = await import('../../lib/flags');
  const projects = await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const number = `PROJECT ${String(project.data.order).padStart(2, '0')}`;
const ongoing = /[—–-]\s*$/.test(project.data.years);

// Real gallery takes over from the legacy single placeholder image once present.
// All plates + exhibition views live in one manually-advanced carousel.
const exhibitionViews = project.data.exhibitionViews ?? [];
const carouselImages = [...(project.data.images ?? []), ...exhibitionViews];
const hasGallery = carouselImages.length > 0;

const placeholderSrc = project.data.coverImage ?? placeholderImage(project.id);
const usingPlaceholder = !hasGallery && !project.data.coverImage;

// Related writing from frontmatter
const allWriting = await getCollection('writing', ({ data }) => SHOW_DRAFTS || !data.draft);
const relatedWriting = (project.data.relatedWriting ?? [])
  .map((slug) => allWriting.find((w) => w.id === slug))
  .filter(Boolean);
const documents = project.data.documents ?? [];

// Related strip: same-collection siblings, v1 rule
const siblings = (await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft))
  .filter((p) => p.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    href: `/projects/${p.id}`,
    title: p.data.title,
    eyebrow: 'Projects',
    meta: p.data.years,
  }));

const enquire = `mailto:jameswilliamkendall@gmail.com?subject=${encodeURIComponent(`Prints — ${project.data.title}`)}`;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <!-- Title block — DS website kit Project pattern -->
  <section class="title-block page-pad">
    <div class="tag-row">
      <Tag>{number}</Tag>
      {ongoing && <Tag tone="red">ONGOING</Tag>}
      <Tag tone="faded">{project.data.years}</Tag>
      {project.data.draft && <Tag tone="faded">DRAFT</Tag>}
    </div>
    <h1>{project.data.title}</h1>
    <p class="standfirst">{project.data.summary}</p>
  </section>

  <!-- Image spread — carousel when a real gallery exists, static placeholder otherwise -->
  {(hasGallery || placeholderSrc) && (
    <section class="spread page-pad">
      {hasGallery ? (
        <div class="carousel" data-carousel>
          <div class="carousel-frame">
            {carouselImages.map((img, i) => (
              <figure class="carousel-slide" hidden={i !== 0}>
                <Image
                  src={img.src}
                  alt={img.caption ?? `${project.data.title}, plate ${i + 1}`}
                  width={1500}
                  height={1125}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </figure>
            ))}
          </div>
          {carouselImages.length > 1 && (
            <div class="carousel-controls">
              <button type="button" class="carousel-prev meta" aria-label="Previous image">← PREV</button>
              <span class="carousel-count meta-micro">
                <span class="carousel-current">01</span> / {String(carouselImages.length).padStart(2, '0')}
              </span>
              <button type="button" class="carousel-next meta" aria-label="Next image">NEXT →</button>
            </div>
          )}
          <p class="caption carousel-caption">
            {carouselImages.map((img, i) => (
              <span class="carousel-caption-text" hidden={i !== 0}>
                {img.caption ?? `${project.data.title}, ${project.data.years}.`}
              </span>
            ))}
          </p>
        </div>
      ) : (
        <figure class="plate">
          <img src={placeholderSrc} alt={`From ${project.data.title}`} />
          {usingPlaceholder && (
            <div class="plate-sticker">
              <Sticker rotate={2} label="TEMP">PLACEHOLDER</Sticker>
            </div>
          )}
          <figcaption class="caption">
            {project.data.title}, {project.data.years}.
          </figcaption>
        </figure>
      )}
      <div class="side">
        <MetaLine border="both" items={['PRINTS', 'ENQUIRE']} />
        {(relatedWriting.length + documents.length) > 0 && (
          <MetaLine border="bottom" items={['WRITING', `[${String(relatedWriting.length + documents.length).padStart(2, '0')}]`]} />
        )}
        <div class="actions">
          <ButtonLink href={enquire} variant="primary">Enquire about prints</ButtonLink>
          <ButtonLink href="/projects" variant="ghost">All projects →</ButtonLink>
        </div>
      </div>
    </section>
  )}

  <!-- Project text -->
  <section class="page-pad">
    <div class="prose">
      <Content />
    </div>
  </section>

  {(relatedWriting.length > 0 || documents.length > 0) && (
    <section class="page-pad writing-block">
      <MetaLine border="both" items={['RELATED WRITING']} />
      <ul class="writing-list">
        {relatedWriting.map((w) => (
          <li>
            <a href={w!.data.externalUrl ?? `/writing/${w!.id}`}>
              <span class="meta-micro">{w!.data.publication ?? 'ESSAY'}</span>
              <span class="writing-title">{w!.data.title}</span>
            </a>
          </li>
        ))}
        {documents.map((doc) => (
          <li>
            <a href={doc.url} target="_blank" rel="noopener noreferrer">
              <span class="meta-micro">PDF</span>
              <span class="writing-title">{doc.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <RelatedStrip items={siblings} heading="More projects" />

  {hasGallery && (
  <script>
    // Manual-advance carousel, one per project page. No autoplay by design —
    // matches the poster system's static, editorial feel.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
      const captions = Array.from(root.querySelectorAll<HTMLElement>('.carousel-caption-text'));
      const prevBtn = root.querySelector<HTMLButtonElement>('.carousel-prev');
      const nextBtn = root.querySelector<HTMLButtonElement>('.carousel-next');
      const counter = root.querySelector<HTMLElement>('.carousel-current');
      let current = 0;

      function show(index: number) {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.hidden = i !== current;
        });
        captions.forEach((caption, i) => {
          caption.hidden = i !== current;
        });
        if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      }

      prevBtn?.addEventListener('click', () => show(current - 1));
      nextBtn?.addEventListener('click', () => show(current + 1));
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    });
  </script>
  )}
</BaseLayout>

<style>
  .title-block {
    padding-top: 36px;
    position: relative;
  }

  .tag-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(56px, 10.5vw, 160px);
  }

  .standfirst {
    max-width: 52ch;
    font-size: 17px;
    margin-top: var(--space-5);
  }

  .spread {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 28px;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    align-items: start;
  }

  .plate {
    position: relative;
    margin: 0;
  }

  .plate img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .plate-sticker {
    position: absolute;
    right: -8px;
    top: 18px;
  }

  .carousel {
    margin: 0;
  }

  .carousel-frame {
    position: relative;
  }

  .carousel-slide {
    margin: 0;
  }

  .carousel-slide :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .carousel-controls {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: var(--border-width-hairline) solid var(--border-hairline);
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
    padding: var(--space-2) 0;
  }

  .carousel-prev,
  .carousel-next {
    background: none;
    border: none;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    color: var(--ink-1);
  }

  .carousel-prev:hover,
  .carousel-next:hover {
    color: var(--signal-red);
  }

  .carousel-count {
    color: var(--ink-3);
  }

  .carousel-caption {
    margin-top: var(--space-2);
  }

  .side :global(.metaline + .metaline) {
    margin-top: 0;
  }

  .actions {
    margin-top: var(--space-5);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .writing-block {
    margin-top: var(--space-7);
  }

  .writing-list {
    list-style: none;
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .writing-list a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .writing-title {
    font-family: var(--font-grotesque);
    font-weight: var(--weight-bold);
    font-size: var(--type-subtitle);
    color: var(--ink-1);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .writing-list a:hover .writing-title {
    color: var(--signal-red);
  }

  @media (max-width: 900px) {
    .spread { grid-template-columns: 1fr; }
  }
</style>
