---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ds/Tag.astro';
import Sticker from '../../components/ds/Sticker.astro';
import MetaLine from '../../components/ds/MetaLine.astro';
import RelatedStrip from '../../components/RelatedStrip.astro';
import Carousel from '../../components/Carousel.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { SHOW_DRAFTS } from '../../lib/flags';
import { placeholderImage } from '../../lib/placeholders';

export async function getStaticPaths() {
  const { SHOW_DRAFTS } = await import('../../lib/flags');
  const projects = await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const number = `PROJECT ${String(project.data.order).padStart(2, '0')}`;
const ongoing = /[—–-]\s*$/.test(project.data.years);

// Real gallery takes over from the legacy single placeholder image once present.
// Exhibition views are documentation of a show, not the artwork itself, so
// they get their own static row further down the page rather than being
// mixed into the plates carousel.
const exhibitionViews = project.data.exhibitionViews ?? [];
const carouselImages = project.data.images ?? [];
const hasGallery = carouselImages.length > 0;

const placeholderSrc = project.data.coverImage ?? placeholderImage(project.id);
const usingPlaceholder = !hasGallery && !project.data.coverImage;

// Related writing from frontmatter
const allWriting = await getCollection('writing', ({ data }) => SHOW_DRAFTS || !data.draft);
const relatedWriting = (project.data.relatedWriting ?? [])
  .map((slug) => allWriting.find((w) => w.id === slug))
  .filter(Boolean);
const documents = project.data.documents ?? [];

// Companion project — a paired project that links back the other way too
// (e.g. Made Beds <-> Unmade Beds), set per-project in frontmatter.
const companion = project.data.companionProject
  ? (await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft)).find(
      (p) => p.id === project.data.companionProject
    )
  : null;

// Related strip: same-collection siblings, v1 rule
const siblings = (await getCollection('projects', ({ data }) => SHOW_DRAFTS || !data.draft))
  .filter((p) => p.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    href: `/projects/${p.id}`,
    title: p.data.title,
    eyebrow: 'Projects',
    meta: p.data.years,
  }));

const enquire = `mailto:jameswilliamkendall@gmail.com?subject=${encodeURIComponent(`Prints — ${project.data.title}`)}`;
---

<BaseLayout title={project.data.title} description={project.data.summary} noindex={project.data.draft}>
  <!-- Title block — DS website kit Project pattern -->
  <section class="title-block page-pad">
    <div class="tag-row">
      <Tag>{number}</Tag>
      {ongoing && <Tag tone="red">ONGOING</Tag>}
      <Tag tone="faded">{project.data.years}</Tag>
      {project.data.draft && <Tag tone="faded">DRAFT</Tag>}
    </div>
    <h1>{project.data.title}</h1>
    <p class="standfirst">{project.data.summary}</p>
  </section>

  <!-- Image spread — full width. Carousel when a real gallery exists, static placeholder otherwise -->
  {(hasGallery || placeholderSrc) && (
    <section class="spread">
      {hasGallery ? (
        <Carousel
          images={carouselImages}
          fallbackCaption={`${project.data.title}, ${project.data.years}.`}
        />
      ) : (
        <figure class="plate">
          <div class="plate-inner">
            <img src={placeholderSrc} alt={`From ${project.data.title}`} />
            {usingPlaceholder && (
              <div class="plate-sticker">
                <Sticker rotate={2} label="TEMP">PLACEHOLDER</Sticker>
              </div>
            )}
            <figcaption class="caption plate-caption">
              {project.data.title}, {project.data.years}.
            </figcaption>
          </div>
        </figure>
      )}
    </section>
  )}

  <!-- Project text -->
  <section class="page-pad">
    <div class="prose">
      <Content />
    </div>
  </section>

  {exhibitionViews.length > 0 && (
    <section class="page-pad exhibition-block">
      <MetaLine
        border="both"
        items={['EXHIBITION VIEWS', `[${String(exhibitionViews.length).padStart(2, '0')}]`]}
      />
      <div class="exhibition-grid">
        {exhibitionViews.map((view, i) => (
          <figure class="exhibition-item">
            <Image
              src={view.src}
              alt={view.caption ?? `Exhibition view ${i + 1}`}
              width={1200}
              height={900}
              loading="lazy"
              style={view.focus ? `object-position: ${view.focus}` : undefined}
            />
            {view.caption && <figcaption class="caption">{view.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {companion && (
    <section class="page-pad companion-block">
      <MetaLine border="both" items={['COMPANION PROJECT', companion.data.years]} />
      <p class="companion-link">
        <a href={`/projects/${companion.id}`}>{companion.data.title}</a>
      </p>
    </section>
  )}

  {(relatedWriting.length > 0 || documents.length > 0) && (
    <section class="page-pad writing-block">
      <MetaLine border="both" items={['RELATED WRITING']} />
      <ul class="writing-list">
        {relatedWriting.map((w) => (
          <li>
            <a href={w!.data.externalUrl ?? `/writing/${w!.id}`}>
              <span class="meta-micro">{w!.data.publication ?? 'ESSAY'}</span>
              <span class="writing-title">{w!.data.title}</span>
            </a>
          </li>
        ))}
        {documents.map((doc) => (
          <li>
            <a href={doc.url} target="_blank" rel="noopener noreferrer">
              <span class="meta-micro">PDF</span>
              <span class="writing-title">{doc.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Prints / enquire — annotated screenshot, 11 Aug: buttons removed, row itself -->
  <!-- is now the link. "MORE PROJECTS" below does the same job the old "All projects" -->
  <!-- button did, so that button's gone too. -->
  <section class="page-pad side-block">
    <div class="prints-row">
      <span>PRINTS</span>
      <a href={enquire}>ENQUIRE →</a>
    </div>
  </section>

  <RelatedStrip items={siblings} heading="More projects" headingHref="/projects" />
</BaseLayout>

<style>
  .title-block {
    padding-top: 36px;
    position: relative;
  }

  .tag-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(56px, 10.5vw, 160px);
  }

  .standfirst {
    max-width: 52ch;
    font-size: 17px;
    margin-top: var(--space-5);
  }

  .spread {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  /* Both the placeholder plate and the real carousel follow the same
     pattern: a full-bleed outer box centres a shrink-wrapped inner group
     (image + caption, left-aligned to each other) sized to the image's own
     rendered dimensions — not a fixed box. With object-fit: contain removed
     in favour of intrinsic sizing, this is what keeps the caption's left
     edge lined up with the photo above it instead of the caption spanning
     the full page width regardless of how the image actually renders. */

  .plate {
    position: relative;
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .plate-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
  }

  .plate-inner img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    /* Caps how tall the image can get on very wide screens. */
    max-height: 82vh;
    background: var(--paper-1);
  }

  .plate-sticker {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    padding: 0 !important;
  }

  .plate-caption {
    padding: 0 var(--page-margin);
    margin-top: var(--space-2);
  }

  .exhibition-block {
    margin-top: var(--space-7);
  }

  /* Deliberately a static grid, not a carousel — these are documentation of
     a show, not the artwork, so they don't need the same one-at-a-time
     treatment as the plates above. Same no-crop rule as everywhere else:
     width 100%, height auto, never object-fit: cover. auto-fit/minmax lets
     5 images settle into whatever column count fits (3+2 on desktop,
     1-up on narrow screens) without a fixed count to maintain. */
  .exhibition-grid {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .exhibition-item {
    margin: 0;
  }

  .exhibition-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-1);
  }

  .exhibition-item figcaption {
    margin-top: var(--space-2);
  }

  .companion-block {
    margin-top: var(--space-7);
  }

  .companion-link {
    margin-top: var(--space-3);
  }

  .companion-link a {
    font-family: var(--font-display);
    font-size: 28px;
    text-transform: uppercase;
    color: var(--ink-1);
  }

  .companion-link a:hover {
    color: var(--signal-red);
  }

  .side-block {
    margin-top: var(--space-5);
  }

  .prints-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 7px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-1);
    border-top: var(--border-width-hairline) solid var(--border-hairline);
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }

  .prints-row a {
    color: inherit;
  }

  .prints-row a:hover {
    color: var(--signal-red);
  }

  .writing-block {
    margin-top: var(--space-7);
  }

  .writing-list {
    list-style: none;
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .writing-list a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .writing-title {
    font-family: var(--font-grotesque);
    font-weight: var(--weight-bold);
    font-size: var(--type-subtitle);
    color: var(--ink-1);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .writing-list a:hover .writing-title {
    color: var(--signal-red);
  }
</style>
