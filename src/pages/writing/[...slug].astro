---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ds/Tag.astro';
import MetaLine from '../../components/ds/MetaLine.astro';
import RelatedStrip from '../../components/RelatedStrip.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const { SHOW_DRAFTS } = await import('../../lib/flags');
  const posts = await getCollection(
    'writing',
    ({ data }) => (SHOW_DRAFTS || !data.draft) && !data.externalUrl
  );
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { SHOW_DRAFTS } = await import('../../lib/flags');

function catalogueDate(d: Date): string {
  // UTC accessors, not local — YAML frontmatter dates parse as UTC midnight,
  // so local getDate() renders the previous day on any build machine in a
  // timezone west of UTC (e.g. a CI runner pinned to a US region).
  const month = d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase();
  return `${String(d.getUTCDate()).padStart(2, '0')} [${month}] ${d.getUTCFullYear()}`;
}

// Related project lookup
const projects = await getCollection('projects');
const related = post.data.relatedProject
  ? projects.find((p) => p.id === post.data.relatedProject)
  : null;

// Related strip: same-collection siblings, v1 rule
const siblings = (await getCollection('writing', ({ data }) => SHOW_DRAFTS || !data.draft))
  .filter((w) => w.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((w) => ({
    href: w.data.externalUrl ?? `/writing/${w.id}`,
    title: w.data.title,
    eyebrow: 'Writing',
    meta: catalogueDate(w.data.date),
  }));
// Article structured data. Author/publisher kept minimal — one Person node,
// no invented organisation. coverImage doubles as the og/share image when set.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  datePublished: post.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'James Kendall', url: new URL('/about', Astro.site).toString() },
  ...(post.data.publication ? { publisher: { '@type': 'Organization', name: post.data.publication } } : {}),
  ...(post.data.coverImage ? { image: new URL(post.data.coverImage, Astro.site).toString() } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  noindex={post.data.draft}
  ogImage={post.data.coverImage}
  structuredData={articleLd}
>
  <article class="piece page-pad">
    <header>
      <div class="tag-row">
        <Tag><a href="/writing">Writing</a></Tag>
        <Tag tone="faded">{post.data.type.toUpperCase().replace('-', ' ')}</Tag>
        {post.data.publication && <Tag tone="faded">{post.data.publication.toUpperCase()}</Tag>}
        {post.data.draft && <Tag tone="faded">DRAFT</Tag>}
      </div>
      <h1 class="display-2">{post.data.title}</h1>
      <MetaLine
        border="both"
        items={[
          catalogueDate(post.data.date),
          ...(post.data.publication ? [post.data.publication.toUpperCase()] : []),
        ]}
        class="date-rail"
      />
    </header>

    <div class="prose serif-prose">
      <Content />
    </div>

    {related && (
      <aside class="related-project">
        <MetaLine border="both" items={['RELATED PROJECT', related.data.years]} />
        <p class="related-link">
          <a href={`/projects/${related.id}`}>{related.data.title}</a>
        </p>
      </aside>
    )}
  </article>

  <RelatedStrip items={siblings} heading="More writing" />
</BaseLayout>

<style>
  .piece {
    padding-top: 36px;
    display: grid;
    gap: var(--space-5);
  }

  .tag-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .tag-row a {
    color: inherit;
  }

  .tag-row a:hover {
    color: var(--signal-red);
  }

  :global(.date-rail) {
    margin-top: var(--space-5);
    max-width: 720px;
  }

  /* Long-form reads in the grotesque; serif reserved for captions per DS */
  .prose {
    max-width: 66ch;
    font-size: 17px;
  }

  .related-project {
    max-width: 720px;
  }

  .related-link {
    margin-top: var(--space-3);
  }

  .related-link a {
    font-family: var(--font-display);
    font-size: 28px;
    text-transform: uppercase;
    color: var(--ink-1);
  }

  .related-link a:hover {
    color: var(--signal-red);
  }
</style>
