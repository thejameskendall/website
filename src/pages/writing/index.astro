---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetaLine from '../../components/ds/MetaLine.astro';
import Tag from '../../components/ds/Tag.astro';
import { getCollection } from 'astro:content';
import { SHOW_DRAFTS } from '../../lib/flags';

const posts = (await getCollection('writing', ({ data }) => SHOW_DRAFTS || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const count = `[${String(posts.length).padStart(2, '0')}]`;

// Catalogue date: 12 [MAR] 2025
function catalogueDate(d: Date): string {
  // UTC accessors, not local — YAML frontmatter dates parse as UTC midnight,
  // so local getDate() renders the previous day on any build machine in a
  // timezone west of UTC (e.g. a CI runner pinned to a US region).
  const month = d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase();
  return `${String(d.getUTCDate()).padStart(2, '0')} [${month}] ${d.getUTCFullYear()}`;
}

const types = [...new Set(posts.map((p) => p.data.type))];
const publications = [...new Set(posts.map((p) => p.data.publication).filter(Boolean))];
---

<BaseLayout title="Writing" description="Music journalism, essays, and project writing by James Kendall.">
  <section class="title-block page-pad">
    <h1>Writing</h1>
  </section>

  <div class="page-pad">
    <MetaLine border="both" items={['MUSIC JOURNALISM + ESSAYS', '1992—', count]} />
    <!-- Filter bar: static for now, wired up during content migration -->
    <div class="filter-bar">
      <Tag tone="red">ALL</Tag>
      {types.map((t) => <Tag tone="faded">{t.toUpperCase().replace('-', ' ')}</Tag>)}
      {publications.map((p) => <Tag tone="faded">{p!.toUpperCase()}</Tag>)}
    </div>
  </div>

  {posts.length === 0 ? (
    <p class="empty page-pad meta">NO PIECES PUBLISHED YET — MIGRATING FROM THE CURRENT SITE</p>
  ) : (
    <ul class="list page-pad">
      {posts.map((p) => (
        <li>
          <a href={p.data.externalUrl ?? `/writing/${p.id}`} class="entry">
            {p.data.coverImage ? (
              <span class="entry-thumb">
                <img src={p.data.coverImage} alt="" loading="lazy" />
              </span>
            ) : (
              <span class="entry-thumb entry-thumb--empty" aria-hidden="true"></span>
            )}
            <span class="entry-body">
              <span class="meta-micro entry-meta">
                {catalogueDate(p.data.date)}
                {p.data.publication ? ` · ${p.data.publication.toUpperCase()}` : ''}
                {p.data.draft ? ' · DRAFT' : ''}
              </span>
              <span class="entry-title">{p.data.title}</span>
              <span class="entry-summary">{p.data.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .title-block {
    padding-top: 36px;
    padding-bottom: var(--space-5);
  }

  .filter-bar {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) 0;
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }

  .list {
    list-style: none;
    padding-top: var(--space-5);
    padding-bottom: 56px;
    display: grid;
    gap: var(--space-6);
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .entry-thumb {
    flex: 0 0 auto;
    width: 120px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-2);
  }

  .entry-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .entry:hover .entry-thumb img {
    transform: scale(1.04);
  }

  .entry-thumb--empty {
    border: var(--border-width-hairline) solid var(--border-hairline);
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 72ch;
    min-width: 0;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 44px);
    line-height: var(--leading-display);
    text-transform: uppercase;
    color: var(--ink-1);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .entry:hover .entry-title {
    color: var(--signal-red);
  }

  .entry-summary {
    color: var(--text-body);
    max-width: 56ch;
  }

  @media (max-width: 560px) {
    .entry-thumb {
      width: 84px;
    }
  }

  .empty {
    padding-top: var(--space-5);
    padding-bottom: 56px;
    color: var(--ink-3);
  }
</style>
