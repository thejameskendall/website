---
import '@fontsource/anton';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/tinos';
import '@fontsource/tinos/400-italic.css';
import '@fontsource/permanent-marker';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { NOINDEX_SITE } from '../lib/flags';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /* JSON-LD structured data (Person, Article, ...). Pages pass a plain
     object; serialised into a script tag in <head>. Optional — most pages
     don't need one. */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'James Kendall — photographer and writer. Contemporary art practice, commercial photography, video, and music journalism.',
  ogImage = '/og-default.jpg',
  noindex = false,
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — James Kendall</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(NOINDEX_SITE || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={`${title} — James Kendall`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
